<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cpa.gateway">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      自动更新（4.52.0）：让本应用能发起安装。
      这个权限**不等于**静默安装 —— 系统仍会弹"是否安装"确认框，用户必须点一次。
      没有它的话 PackageInstaller 会话会被系统直接拦掉（STATUS_FAILURE_BLOCKED），
      表现是"点立即更新没反应"。
      Android 14+ 的 Play 政策对这类权限有限制，但本项目从 GitHub Release 自装自更新，
      是它合法的用途（应用自己升级自己）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name="com.cpa.gateway.CpaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.SettingsActivity"
            android:exported="false"
            android:label="设置" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.AccountsActivity"
            android:exported="false"
            android:label="账号" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.UnusableActivity"
            android:exported="false"
            android:label="暂不可用的账号" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.AccountDetailActivity"
            android:exported="false"
            android:label="账号详情" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.ModelsActivity"
            android:exported="false"
            android:label="模型" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.LogActivity"
            android:exported="false"
            android:label="网关日志" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.BrowseActivity"
            android:exported="false"
            android:label="官网"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.WebLoginActivity"
            android:exported="false"
            android:label="自定义中转站"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.ClineLoginActivity"
            android:exported="false"
            android:label="登录 Cline" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.XaiLoginActivity"
            android:exported="false"
            android:label="登录 Grok" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.KimiLoginActivity"
            android:exported="false"
            android:label="登录 Kimi Code" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.DeepSeekLoginActivity"
            android:exported="false"
            android:label="登录 DeepSeek" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.DoubaoLoginActivity"
            android:exported="false"
            android:label="登录豆包" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.AntigravityLoginActivity"
            android:exported="false"
            android:label="登录 Google 账号"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.TraeLoginActivity"
            android:exported="false"
            android:label="登录 Trae"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.LoomyLoginActivity"
            android:exported="false"
            android:label="登录 Loomy"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.OAuthLoginActivity"
            android:exported="false"
            android:label="登录账号"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:screenOrientation="portrait"
            android:name="com.cpa.gateway.WorkBuddyLoginActivity"
            android:exported="false"
            android:label="登录 WorkBuddy"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name="com.cpa.gateway.GatewayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local AI API gateway that proxies requests to configured providers" />
        </service>

        <service
            android:name="com.cpa.gateway.GatewayTileService"
            android:exported="true"
            android:icon="@drawable/ic_notify"
            android:label="CLIProxy 网关"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.cpa.gateway.KeepAliveJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          自动更新（4.52.0）：收 PackageInstaller 的安装结果，装成功后清理下载包。
          exported=false —— 它只接本应用自己 PendingIntent 发出的广播，
          对外开放等于让任何应用伪造"安装成功"来删文件（虽然危害小，但没必要冒）。
        -->
        <receiver
            android:name="com.cpa.gateway.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name="com.cpa.gateway.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
