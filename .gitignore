# 构建产物（build.sh 每次会 rm -rf out 重建）
out/
*.apk
*.apk.idsig

# 签名密钥：绝不入库
keystore.jks
*.jks
*.keystore

# 私库专用目录（签名密钥、口令、同步脚本、历史备份）：
# 公库永远不该出现；私库里用 `git add -f .private/...` 显式跟踪。
.private/

# 签名口令与任何本地凭据：绝不入库
# （build.sh 从这个文件/环境变量读口令，源码里不再出现明文）
.env
.env.*
!.env.example
*.secrets

# 本地临时
*.log
*.tmp
.DS_Store

# 编辑器
.idea/
*.iml
