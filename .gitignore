# 构建产物（build.sh 每次会 rm -rf out 重建）
out/
*.apk
*.apk.idsig

# 签名密钥：绝不入库
keystore.jks
*.jks
*.keystore

# 私库专用目录（签名密钥、口令、同步脚本、历史备份）：
# 公库永远不该出现；私库里用 `git add -f .private/...` 显式跟踪。
.private/

# 签名口令与任何本地凭据：绝不入库
# （build.sh 从这个文件/环境变量读口令，源码里不再出现明文）
.env
.env.*
!.env.example
*.secrets

# 本地临时
*.log
*.tmp
.DS_Store

# 编辑器
.idea/
*.iml

# 私库工作约定（claude 项目：构建/发版/安全约束）。
# 私库**要**跟踪它（换机或重装后不用重新录一遍），但它写的是私库工作流
# （双仓库、.private/、priv 命令、本机绝对路径），对公库读者是噪音 ——
# 所以进公库只能靠 `git add -f`，平时 `git add -A` 不会带上它。
CLAUDE.md
.claude/
