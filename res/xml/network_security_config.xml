<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：默认禁止明文流量，只对本机回环地址开口子。

  背景：以前这里是全局 android:usesCleartextTraffic="true"，等于允许任何域名走明文 HTTP。
  实际上游全是 HTTPS（api.anthropic.com / api.openai.com / accounts.x.ai / 各家兼容站…），
  真正需要明文的只有两类回环地址：
    · 本机网关自身      http://127.0.0.1:<port> /v1/…
    · OAuth 本机回调     http://localhost:1455/auth/callback
                        http://localhost:54545/callback
                        http://127.0.0.1:51120/authorize（Trae）
  这些地址不出网卡，没有中间人风险；把明文限制在它们身上，可以让「配置里的 API Key
  和聊天内容不会被降级成明文上行」成为一条系统级保证，而不是靠代码里每处都记得用 https。
-->
<network-security-config>
    <!-- 默认：禁止明文，全部要求 TLS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 唯一的例外：本机回环（网关自身 + OAuth 回调） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
