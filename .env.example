# 复制成 .env（已被 .gitignore 排除），填入自己的值后：
#
#   set -a && . ./.env && set +a && ./build.sh
#
# 注意 set -a 要在 source 之前：否则变量只存在于当前 shell，不会导出给
# build.sh 里的 apksigner 子进程，签名步骤会报「没有提供签名密钥口令」。

# Android SDK 根目录（需要 platforms/android-35/android.jar 与 build-tools/35.0.0/d8）
ANDROID_SDK=/path/to/android-sdk

# 签名口令（不要提交这个文件）
KS_STOREPASS=
KS_KEYPASS=

# 可选：密钥路径，默认 ./keystore.jks
# KS_PATH=/path/to/keystore.jks
